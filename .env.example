# Supabase (safe to expose only these two public values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Qwen Cloud — primary provider
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_ENABLE_THINKING=true
QWEN_TIMEOUT_MS=120000

# GMI Cloud — fallback provider
GMI_API_KEY=
GMI_BASE_URL=
GMI_MODEL=

# Enables a deterministic fallback only for the preset locker demo
DEMO_MODE=false

# Optional deployment metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Daytona smoke testing
DAYTONA_API_KEY=
